          <dc:Bounds x="768.0" y="309.0" width="120" height="24" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="contracts-main_F6_DI" bpmnElement="contracts-main_F6">
        <di:waypoint x="1040.0" y="495.0" />
        <di:waypoint x="1075.0" y="495.0" />
        <di:waypoint x="1075.0" y="815.0" />
        <di:waypoint x="1110.0" y="815.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="contracts-main_F7_DI" bpmnElement="contracts-main_F7">
        <di:waypoint x="1290.0" y="815.0" />
        <di:waypoint x="1325.0" y="815.0" />
        <di:waypoint x="1325.0" y="655.0" />
        <di:waypoint x="1360.0" y="655.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="contracts-main_F8_DI" bpmnElement="contracts-main_F8">
        <di:waypoint x="1540.0" y="655.0" />
        <di:waypoint x="1575.0" y="655.0" />
        <di:waypoint x="1575.0" y="815.0" />
        <di:waypoint x="1610.0" y="815.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="contracts-main_F9_DI" bpmnElement="contracts-main_F9">
        <di:waypoint x="1790.0" y="815.0" />
        <di:waypoint x="1825.0" y="815.0" />
        <di:waypoint x="1825.0" y="975.0" />
        <di:waypoint x="1860.0" y="975.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="contracts-main_F10_DI" bpmnElement="contracts-main_F10">
        <di:waypoint x="2040.0" y="975.0" />
        <di:waypoint x="2100.0" y="975.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="contracts-main_F11_DI" bpmnElement="contracts-main_F11">
        <di:waypoint x="2280.0" y="975.0" />
        <di:waypoint x="2375.0" y="975.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="contracts-main_F12_DI" bpmnElement="contracts-main_F12">
