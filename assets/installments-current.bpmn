<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="installments-current_Definitions" targetNamespace="https://example.invalid/portfolio-models" exporter="Project modeling pack" exporterVersion="1.0">
  <bpmn:process id="installments-current" name="Расчёт отчёта по рассрочке" isExecutable="false">
    <bpmn:documentation>По прочитанному снимку исходного кода. Источник: audit/installment-control, а не проверка действующего портала. Bitrix24 хранит сделки и карточки платежей. Приложение читает данные, считает виртуальное перенесение переплаты только вперёд по графику и возвращает отчёт; запись переноса в CRM не обнаружена. Доступ и транспортные ошибки показаны на уровне границы системы. Это модель одного запроса отчёта, не процесса поступления денег.</bpmn:documentation>
    <bpmn:laneSet id="installments-current_Lanes">
      <bpmn:lane id="installments-current_L0" name="Пользователь">
        <bpmn:flowNodeRef>i_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i_filter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i_error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i_failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i_view</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="installments-current_L1" name="Приложение">
        <bpmn:flowNodeRef>i_load</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i_reply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i_group</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i_calc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i_summary</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="installments-current_L2" name="Bitrix24 CRM">
        <bpmn:flowNodeRef>i_crm</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="i_start" name="Нужен отчёт">
      <bpmn:outgoing>installments-current_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="i_filter" name="Выбрать вкладку и фильтры">
      <bpmn:incoming>installments-current_F1</bpmn:incoming>
      <bpmn:outgoing>installments-current_F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="i_load" name="Запросить доступные карточки и сделки">
      <bpmn:documentation>BitrixDataProvider: crm.item.list, crm.deal.list. parentId2 связывает платёж со сделкой. Пагинация; карточки без читаемой сделки исключаются.</bpmn:documentation>
      <bpmn:incoming>installments-current_F2</bpmn:incoming>
      <bpmn:outgoing>installments-current_F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="i_crm" name="Вернуть записи с учётом прав CRM">
      <bpmn:incoming>installments-current_F3</bpmn:incoming>
      <bpmn:outgoing>installments-current_F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="i_reply" name="Данные получены?" gatewayDirection="Diverging" default="installments-current_F5">
      <bpmn:incoming>installments-current_F4</bpmn:incoming>
      <bpmn:outgoing>installments-current_F5</bpmn:outgoing>
      <bpmn:outgoing>installments-current_F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="i_error" name="Показать ошибку загрузки">
      <bpmn:incoming>installments-current_F5</bpmn:incoming>
      <bpmn:outgoing>installments-current_F6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="i_failed" name="Отчёт не построен">
      <bpmn:incoming>installments-current_F6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="i_group" name="Сгруппировать по сделке; сортировать график">
      <bpmn:documentation>Внутри каждой сделки сортировка по плановой дате, времени создания и ID.</bpmn:documentation>
      <bpmn:incoming>installments-current_F7</bpmn:incoming>
      <bpmn:outgoing>installments-current_F8</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="i_calc" name="Посчитать остатки и виртуальную переплату">
      <bpmn:documentation>effective=max(0,plan-incomingCredit); remaining=max(0,effective-paid); outgoingCredit=max(0,incomingCredit+paid-plan). Кредит передаётся только следующей карточке. Это вычисления в памяти.</bpmn:documentation>
      <bpmn:incoming>installments-current_F8</bpmn:incoming>
      <bpmn:outgoing>installments-current_F9</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="i_summary" name="Собрать отчёт и итоговые показатели">
      <bpmn:documentation>Стоимость договора учитывается на уровне уникальной сделки, а не повторно по каждому платежу. При фильтрах сначала нужен полный график выбранных сделок для перенесения переплаты.</bpmn:documentation>
      <bpmn:incoming>installments-current_F9</bpmn:incoming>
      <bpmn:outgoing>installments-current_F10</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:userTask id="i_view" name="Просмотреть график и расхождения с CRM">
      <bpmn:documentation>Виртуальные статусы отчёта и стадии CRM показаны отдельно. requiresReview и crmMismatch — признаки отчёта, не выполненные действия.</bpmn:documentation>
      <bpmn:incoming>installments-current_F10</bpmn:incoming>
      <bpmn:outgoing>installments-current_F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="i_end" name="Отчёт показан">
      <bpmn:incoming>installments-current_F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="installments-current_F1" sourceRef="i_start" targetRef="i_filter" name="" />
    <bpmn:sequenceFlow id="installments-current_F2" sourceRef="i_filter" targetRef="i_load" name="" />
    <bpmn:sequenceFlow id="installments-current_F3" sourceRef="i_load" targetRef="i_crm" name="" />
    <bpmn:sequenceFlow id="installments-current_F4" sourceRef="i_crm" targetRef="i_reply" name="" />
    <bpmn:sequenceFlow id="installments-current_F5" sourceRef="i_reply" targetRef="i_error" name="Нет" />
    <bpmn:sequenceFlow id="installments-current_F6" sourceRef="i_error" targetRef="i_failed" name="" />
    <bpmn:sequenceFlow id="installments-current_F7" sourceRef="i_reply" targetRef="i_group" name="Да">
      <bpmn:conditionExpression>loadSucceeded = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="installments-current_F8" sourceRef="i_group" targetRef="i_calc" name="" />
    <bpmn:sequenceFlow id="installments-current_F9" sourceRef="i_calc" targetRef="i_summary" name="" />
    <bpmn:sequenceFlow id="installments-current_F10" sourceRef="i_summary" targetRef="i_view" name="" />
    <bpmn:sequenceFlow id="installments-current_F11" sourceRef="i_view" targetRef="i_end" name="" />
  </bpmn:process>
  <bpmn:collaboration id="installments-current_Collaboration">
    <bpmn:participant id="installments-current_Pool" name="По прочитанному снимку исходного кода" processRef="installments-current" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="installments-current_Diagram" name="Расчёт отчёта по рассрочке">
    <bpmndi:BPMNPlane id="installments-current_Plane" bpmnElement="installments-current_Collaboration">
      <bpmndi:BPMNShape id="installments-current_PoolDI" bpmnElement="installments-current_Pool" isHorizontal="true">
        <dc:Bounds x="30" y="95" width="2260" height="480" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="installments-current_L0DI" bpmnElement="installments-current_L0" isHorizontal="true">
        <dc:Bounds x="60" y="95" width="2230" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="installments-current_L1DI" bpmnElement="installments-current_L1" isHorizontal="true">
        <dc:Bounds x="60" y="255" width="2230" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="installments-current_L2DI" bpmnElement="installments-current_L2" isHorizontal="true">
        <dc:Bounds x="60" y="415" width="2230" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="i_start_DI" bpmnElement="i_start">
        <dc:Bounds x="122.0" y="157.0" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="72.0" y="201.0" width="136" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="i_filter_DI" bpmnElement="i_filter">
        <dc:Bounds x="250.0" y="137.0" width="180" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="i_load_DI" bpmnElement="i_load">
        <dc:Bounds x="500.0" y="297.0" width="180" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="i_crm_DI" bpmnElement="i_crm">
        <dc:Bounds x="740.0" y="457.0" width="180" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="i_reply_DI" bpmnElement="i_reply">
        <dc:Bounds x="1015.0" y="310.0" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="965.0" y="368.0" width="150" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="i_error_DI" bpmnElement="i_error">
        <dc:Bounds x="950.0" y="137.0" width="180" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="i_failed_DI" bpmnElement="i_failed">
        <dc:Bounds x="1262.0" y="157.0" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1212.0" y="201.0" width="136" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="i_group_DI" bpmnElement="i_group">
        <dc:Bounds x="1210.0" y="297.0" width="180" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="i_calc_DI" bpmnElement="i_calc">
        <dc:Bounds x="1460.0" y="297.0" width="180" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="i_summary_DI" bpmnElement="i_summary">
        <dc:Bounds x="1710.0" y="297.0" width="180" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="i_view_DI" bpmnElement="i_view">
        <dc:Bounds x="1960.0" y="137.0" width="180" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="i_end_DI" bpmnElement="i_end">
        <dc:Bounds x="2202.0" y="157.0" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2152.0" y="201.0" width="136" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="installments-current_F1_DI" bpmnElement="installments-current_F1">
        <di:waypoint x="158.0" y="175.0" />
        <di:waypoint x="250.0" y="175.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="installments-current_F2_DI" bpmnElement="installments-current_F2">
        <di:waypoint x="430.0" y="175.0" />
        <di:waypoint x="465.0" y="175.0" />
        <di:waypoint x="465.0" y="335.0" />
        <di:waypoint x="500.0" y="335.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="installments-current_F3_DI" bpmnElement="installments-current_F3">
        <di:waypoint x="680.0" y="335.0" />
        <di:waypoint x="710.0" y="335.0" />
        <di:waypoint x="710.0" y="495.0" />
        <di:waypoint x="740.0" y="495.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="installments-current_F4_DI" bpmnElement="installments-current_F4">
        <di:waypoint x="920.0" y="495.0" />
        <di:waypoint x="967.5" y="495.0" />
        <di:waypoint x="967.5" y="335.0" />
        <di:waypoint x="1015.0" y="335.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="installments-current_F5_DI" bpmnElement="installments-current_F5">
        <di:waypoint x="1040" y="310" />
        <di:waypoint x="1040" y="213" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1043" y="284" width="120" height="24" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="installments-current_F6_DI" bpmnElement="installments-current_F6">
        <di:waypoint x="1130.0" y="175.0" />
        <di:waypoint x="1262.0" y="175.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="installments-current_F7_DI" bpmnElement="installments-current_F7">
        <di:waypoint x="1065.0" y="335.0" />
        <di:waypoint x="1210.0" y="335.0" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1068.0" y="309.0" width="120" height="24" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="installments-current_F8_DI" bpmnElement="installments-current_F8">
        <di:waypoint x="1390.0" y="335.0" />
        <di:waypoint x="1460.0" y="335.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="installments-current_F9_DI" bpmnElement="installments-current_F9">
        <di:waypoint x="1640.0" y="335.0" />
        <di:waypoint x="1710.0" y="335.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="installments-current_F10_DI" bpmnElement="installments-current_F10">
        <di:waypoint x="1890.0" y="335.0" />
        <di:waypoint x="1925.0" y="335.0" />
        <di:waypoint x="1925.0" y="175.0" />
        <di:waypoint x="1960.0" y="175.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="installments-current_F11_DI" bpmnElement="installments-current_F11">
        <di:waypoint x="2140.0" y="175.0" />
        <di:waypoint x="2202.0" y="175.0" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>