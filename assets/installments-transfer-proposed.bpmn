<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="installments-transfer-proposed_Definitions" targetNamespace="https://example.invalid/portfolio-models" exporter="Project modeling pack" exporterVersion="1.0">
  <bpmn:process id="installments-transfer-proposed" name="Подтверждённый перенос переплаты между карточками" isExecutable="false">
    <bpmn:documentation>Предлагаемая доработка, не реализована. Одна операция внутри одного договора. Реальные поступления по карточкам не переписываются. Хранилище журнала ещё не выбрано; отдельный смарт-процесс Bitrix24 — один из вариантов, не установленная таблица. Порядок выбора получателя и доступные REST-методы требуют согласования. Нет общей атомарной транзакции между несколькими REST-записями: необходимы идемпотентность и восстановление.</bpmn:documentation>
    <bpmn:laneSet id="installments-transfer-proposed_Lanes">
      <bpmn:lane id="installments-transfer-proposed_L0" name="РОП">
        <bpmn:flowNodeRef>t_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_no</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="installments-transfer-proposed_L1" name="Приложение">
        <bpmn:flowNodeRef>t_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reconcile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_open</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="installments-transfer-proposed_L2" name="Bitrix24 и журнал операций">
        <bpmn:flowNodeRef>t_pending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="t_start" name="Нужно перераспределение">
      <bpmn:outgoing>installments-transfer-proposed_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t_choose" name="Выбрать источник, получателя, сумму и комментарий">
      <bpmn:incoming>installments-transfer-proposed_F1</bpmn:incoming>
      <bpmn:outgoing>installments-transfer-proposed_F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t_confirm" name="Подтвердить перенос РОПом">
      <bpmn:documentation>Приложение не записывает предложенный перенос автоматически.</bpmn:documentation>
      <bpmn:incoming>installments-transfer-proposed_F2</bpmn:incoming>
      <bpmn:outgoing>installments-transfer-proposed_F3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_check" name="Перечитать обе карточки и проверить условия">
      <bpmn:documentation>Права РОПа; одна сделка; разные карточки; сумма &gt; 0; достаточно доступной переплаты; повтор запроса не создаёт новую операцию. Проверка актуальных данных и защита от конкурентной операции обязательны.</bpmn:documentation>
      <bpmn:incoming>installments-transfer-proposed_F3</bpmn:incoming>
      <bpmn:outgoing>installments-transfer-proposed_F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="t_valid" name="Проверка пройдена?" gatewayDirection="Diverging" default="installments-transfer-proposed_F5">
      <bpmn:incoming>installments-transfer-proposed_F4</bpmn:incoming>
      <bpmn:outgoing>installments-transfer-proposed_F5</bpmn:outgoing>
      <bpmn:outgoing>installments-transfer-proposed_F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="t_no" name="Отказ; карточки не изменены">
      <bpmn:incoming>installments-transfer-proposed_F5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_pending" name="Создать операцию в ожидании с уникальным ID">
      <bpmn:documentation>Зафиксировать исходное состояние, источник, получателя, сумму, автора и комментарий. Способ надёжного ограничения конкурентной записи должен быть определён при реализации.</bpmn:documentation>
      <bpmn:incoming>installments-transfer-proposed_F6</bpmn:incoming>
      <bpmn:outgoing>installments-transfer-proposed_F7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_apply" name="Записать зачёт и проверить обе карточки">
      <bpmn:documentation>Входящий/исходящий зачёт отделены от факта оплаты. Один ID операции для повторов. При частичной записи нельзя объявлять успех.</bpmn:documentation>
      <bpmn:incoming>installments-transfer-proposed_F7</bpmn:incoming>
      <bpmn:outgoing>installments-transfer-proposed_F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="t_ok" name="Обе записи подтверждены?" gatewayDirection="Diverging" default="installments-transfer-proposed_F11">
      <bpmn:incoming>installments-transfer-proposed_F8</bpmn:incoming>
      <bpmn:outgoing>installments-transfer-proposed_F9</bpmn:outgoing>
      <bpmn:outgoing>installments-transfer-proposed_F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_commit" name="Завершить журнал; пересчитать статусы">
      <bpmn:documentation>Сумма входящих зачётов равна сумме исходящих. Факт оплаты сохранён. Задачу проверки закрывать только после подтверждённой операции.</bpmn:documentation>
      <bpmn:incoming>installments-transfer-proposed_F9</bpmn:incoming>
      <bpmn:outgoing>installments-transfer-proposed_F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="t_end" name="Перенос подтверждён">
      <bpmn:incoming>installments-transfer-proposed_F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_reconcile" name="Зафиксировать ошибку; восстановить согласованность">
      <bpmn:documentation>Идемпотентный повтор или компенсирующая операция по выбранной реализации. Не смешивать сумму ожидания с подтверждённым зачётом.</bpmn:documentation>
      <bpmn:incoming>installments-transfer-proposed_F11</bpmn:incoming>
      <bpmn:outgoing>installments-transfer-proposed_F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="t_open" name="Требуется восстановление">
      <bpmn:incoming>installments-transfer-proposed_F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="installments-transfer-proposed_F1" sourceRef="t_start" targetRef="t_choose" name="" />
    <bpmn:sequenceFlow id="installments-transfer-proposed_F2" sourceRef="t_choose" targetRef="t_confirm" name="" />
    <bpmn:sequenceFlow id="installments-transfer-proposed_F3" sourceRef="t_confirm" targetRef="t_check" name="" />
    <bpmn:sequenceFlow id="installments-transfer-proposed_F4" sourceRef="t_check" targetRef="t_valid" name="" />
    <bpmn:sequenceFlow id="installments-transfer-proposed_F5" sourceRef="t_valid" targetRef="t_no" name="Нет" />
    <bpmn:sequenceFlow id="installments-transfer-proposed_F6" sourceRef="t_valid" targetRef="t_pending" name="Да">
      <bpmn:conditionExpression>validationSucceeded = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="installments-transfer-proposed_F7" sourceRef="t_pending" targetRef="t_apply" name="" />
    <bpmn:sequenceFlow id="installments-transfer-proposed_F8" sourceRef="t_apply" targetRef="t_ok" name="" />
    <bpmn:sequenceFlow id="installments-transfer-proposed_F9" sourceRef="t_ok" targetRef="t_commit" name="Да">
      <bpmn:conditionExpression>bothWritesVerified = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="installments-transfer-proposed_F10" sourceRef="t_commit" targetRef="t_end" name="" />
    <bpmn:sequenceFlow id="installments-transfer-proposed_F11" sourceRef="t_ok" targetRef="t_reconcile" name="Нет" />
    <bpmn:sequenceFlow id="installments-transfer-proposed_F12" sourceRef="t_reconcile" targetRef="t_open" name="" />
  </bpmn:process>
  <bpmn:collaboration id="installments-transfer-proposed_Collaboration">
    <bpmn:participant id="installments-transfer-proposed_Pool" name="Предлагаемая доработка, не реализована" processRef="installments-transfer-proposed" />
  </bpmn:collaboration>
