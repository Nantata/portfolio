<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="contracts-review_Definitions" targetNamespace="https://example.invalid/portfolio-models" exporter="Project modeling pack" exporterVersion="1.0">
  <bpmn:process id="contracts-review" name="Обязательный контроль версии и возврат на доработку" isExecutable="false">
    <bpmn:documentation>Проектная модель по требованиям. Применяется к правкам контрагента и возврату версии генеральным директором. После правок нельзя направлять документ прямо ГД: повторяется обязательный контроль. Ветвь замечаний бухгалтера здесь не детализирована; её точный порядок следует сверить с владельцем процесса.</bpmn:documentation>
    <bpmn:laneSet id="contracts-review_Lanes">
      <bpmn:lane id="contracts-review_L0" name="Юрист">
        <bpmn:flowNodeRef>r_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_lawyer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="contracts-review_L1" name="Бухгалтер">
        <bpmn:flowNodeRef>r_accountant</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="contracts-review_L2" name="Генеральный директор">
        <bpmn:flowNodeRef>r_director</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_return</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="contracts-review_L3" name="Приложение">
        <bpmn:flowNodeRef>r_record</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="contracts-review_L4" name="Исполнитель правок">
        <bpmn:flowNodeRef>r_fix</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="r_start" name="Версия на контроле">
      <bpmn:outgoing>contracts-review_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="r_lawyer" name="Проверить версию и правки">
      <bpmn:incoming>contracts-review_F1</bpmn:incoming>
      <bpmn:outgoing>contracts-review_F2</bpmn:outgoing>
      <bpmn:incoming>contracts-review_F10</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:userTask id="r_accountant" name="Провести бухгалтерскую проверку">
      <bpmn:incoming>contracts-review_F2</bpmn:incoming>
      <bpmn:outgoing>contracts-review_F3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="r_director" name="Принять решение по версии">
      <bpmn:incoming>contracts-review_F3</bpmn:incoming>
      <bpmn:outgoing>contracts-review_F4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="r_ok" name="Согласовано?" gatewayDirection="Diverging" default="contracts-review_F7">
      <bpmn:incoming>contracts-review_F4</bpmn:incoming>
      <bpmn:outgoing>contracts-review_F5</bpmn:outgoing>
      <bpmn:outgoing>contracts-review_F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="r_final" name="Выпустить согласованную версию">
      <bpmn:incoming>contracts-review_F5</bpmn:incoming>
      <bpmn:outgoing>contracts-review_F6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="r_end" name="Контроль пройден">
      <bpmn:incoming>contracts-review_F6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="r_return" name="Выбрать получателя; указать замечания">
      <bpmn:incoming>contracts-review_F7</bpmn:incoming>
      <bpmn:outgoing>contracts-review_F8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="r_record" name="Сохранить решение и новое исполнение">
      <bpmn:incoming>contracts-review_F8</bpmn:incoming>
      <bpmn:outgoing>contracts-review_F9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="r_fix" name="Внести правки по замечаниям">
      <bpmn:incoming>contracts-review_F9</bpmn:incoming>
      <bpmn:outgoing>contracts-review_F10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="contracts-review_F1" sourceRef="r_start" targetRef="r_lawyer" name="" />
    <bpmn:sequenceFlow id="contracts-review_F2" sourceRef="r_lawyer" targetRef="r_accountant" name="" />
    <bpmn:sequenceFlow id="contracts-review_F3" sourceRef="r_accountant" targetRef="r_director" name="" />
    <bpmn:sequenceFlow id="contracts-review_F4" sourceRef="r_director" targetRef="r_ok" name="" />
    <bpmn:sequenceFlow id="contracts-review_F5" sourceRef="r_ok" targetRef="r_final" name="Да">
      <bpmn:conditionExpression>versionApproved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="contracts-review_F6" sourceRef="r_final" targetRef="r_end" name="" />
    <bpmn:sequenceFlow id="contracts-review_F7" sourceRef="r_ok" targetRef="r_return" name="Нет" />
    <bpmn:sequenceFlow id="contracts-review_F8" sourceRef="r_return" targetRef="r_record" name="" />
    <bpmn:sequenceFlow id="contracts-review_F9" sourceRef="r_record" targetRef="r_fix" name="" />
    <bpmn:sequenceFlow id="contracts-review_F10" sourceRef="r_fix" targetRef="r_lawyer" name="" />
  </bpmn:process>
  <bpmn:collaboration id="contracts-review_Collaboration">
    <bpmn:participant id="contracts-review_Pool" name="Проектная модель по требованиям" processRef="contracts-review" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="contracts-review_Diagram" name="Обязательный контроль версии и возврат на доработку">
    <bpmndi:BPMNPlane id="contracts-review_Plane" bpmnElement="contracts-review_Collaboration">
      <bpmndi:BPMNShape id="contracts-review_PoolDI" bpmnElement="contracts-review_Pool" isHorizontal="true">
        <dc:Bounds x="30" y="95" width="1600" height="800" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="contracts-review_L0DI" bpmnElement="contracts-review_L0" isHorizontal="true">
        <dc:Bounds x="60" y="95" width="1570" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="contracts-review_L1DI" bpmnElement="contracts-review_L1" isHorizontal="true">
        <dc:Bounds x="60" y="255" width="1570" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="contracts-review_L2DI" bpmnElement="contracts-review_L2" isHorizontal="true">
        <dc:Bounds x="60" y="415" width="1570" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="contracts-review_L3DI" bpmnElement="contracts-review_L3" isHorizontal="true">
        <dc:Bounds x="60" y="575" width="1570" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="contracts-review_L4DI" bpmnElement="contracts-review_L4" isHorizontal="true">
        <dc:Bounds x="60" y="735" width="1570" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="r_start_DI" bpmnElement="r_start">
        <dc:Bounds x="122.0" y="157.0" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="72.0" y="201.0" width="136" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="r_lawyer_DI" bpmnElement="r_lawyer">
        <dc:Bounds x="240.0" y="137.0" width="180" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="r_accountant_DI" bpmnElement="r_accountant">
        <dc:Bounds x="480.0" y="297.0" width="180" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="r_director_DI" bpmnElement="r_director">
        <dc:Bounds x="720.0" y="457.0" width="180" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="r_ok_DI" bpmnElement="r_ok">
        <dc:Bounds x="995.0" y="470.0" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="945.0" y="528.0" width="150" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="r_final_DI" bpmnElement="r_final">
        <dc:Bounds x="1190.0" y="137.0" width="180" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="r_end_DI" bpmnElement="r_end">
        <dc:Bounds x="1502.0" y="157.0" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1452.0" y="201.0" width="136" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="r_return_DI" bpmnElement="r_return">
        <dc:Bounds x="1160.0" y="457.0" width="180" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="r_record_DI" bpmnElement="r_record">
        <dc:Bounds x="1160.0" y="617.0" width="180" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="r_fix_DI" bpmnElement="r_fix">
        <dc:Bounds x="890.0" y="777.0" width="180" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="contracts-review_F1_DI" bpmnElement="contracts-review_F1">
        <di:waypoint x="158.0" y="175.0" />
        <di:waypoint x="240.0" y="175.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="contracts-review_F2_DI" bpmnElement="contracts-review_F2">
        <di:waypoint x="420.0" y="175.0" />
        <di:waypoint x="450.0" y="175.0" />
        <di:waypoint x="450.0" y="335.0" />
        <di:waypoint x="480.0" y="335.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="contracts-review_F3_DI" bpmnElement="contracts-review_F3">
        <di:waypoint x="660.0" y="335.0" />
        <di:waypoint x="690.0" y="335.0" />
        <di:waypoint x="690.0" y="495.0" />
        <di:waypoint x="720.0" y="495.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="contracts-review_F4_DI" bpmnElement="contracts-review_F4">
        <di:waypoint x="900.0" y="495.0" />
        <di:waypoint x="995.0" y="495.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="contracts-review_F5_DI" bpmnElement="contracts-review_F5">
        <di:waypoint x="1020" y="470" />
        <di:waypoint x="1020" y="175" />
        <di:waypoint x="1190" y="175" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1023" y="444" width="120" height="24" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="contracts-review_F6_DI" bpmnElement="contracts-review_F6">
        <di:waypoint x="1370.0" y="175.0" />
        <di:waypoint x="1502.0" y="175.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="contracts-review_F7_DI" bpmnElement="contracts-review_F7">
        <di:waypoint x="1045.0" y="495.0" />
        <di:waypoint x="1160.0" y="495.0" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1048.0" y="469.0" width="120" height="24" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="contracts-review_F8_DI" bpmnElement="contracts-review_F8">
        <di:waypoint x="1160.0" y="495.0" />
        <di:waypoint x="1250.0" y="495.0" />
        <di:waypoint x="1250.0" y="655.0" />
        <di:waypoint x="1340.0" y="655.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="contracts-review_F9_DI" bpmnElement="contracts-review_F9">
        <di:waypoint x="1160.0" y="655.0" />
        <di:waypoint x="1115.0" y="655.0" />
        <di:waypoint x="1115.0" y="815.0" />
        <di:waypoint x="1070.0" y="815.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="contracts-review_F10_DI" bpmnElement="contracts-review_F10">
        <di:waypoint x="890" y="815" />
        <di:waypoint x="200" y="815" />
        <di:waypoint x="200" y="175" />
        <di:waypoint x="240" y="175" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>